# Sweet Home 3D 7.7-Online - Environment Configuration
# Copy this file to .env and customize the values

# ============================================
# Application Version
# ============================================
VERSION=7.7

# ============================================
# Network Configuration
# ============================================
# Port on which Sweet Home 3D will be accessible
HOST_PORT=8080

# ============================================
# Storage Configuration
# ============================================
# Path where user projects will be stored
# Options:
#   - Relative path: ./homes (default, stored in project directory)
#   - Absolute path: /mnt/nfs/sweethome3d/homes (for external storage)
#   - Named volume: homes (Docker managed volume)
STORAGE_PATH=./homes

# ============================================
# PHP Configuration
# ============================================
# Maximum file upload size (for .sh3d projects)
UPLOAD_MAX_FILESIZE=50M

# Maximum POST data size
POST_MAX_SIZE=50M

# PHP memory limit
MEMORY_LIMIT=256M

# ============================================
# Authentication Configuration
# ============================================
# Enable HTTP Basic Authentication
# Set to 'true' to require username/password
AUTH_ENABLED=false

# Username for HTTP Basic Auth (only used if AUTH_ENABLED=true)
AUTH_USERNAME=admin

# Password for HTTP Basic Auth (only used if AUTH_ENABLED=true)
# SECURITY: Do NOT commit real passwords to version control!
# Leave empty to auto-generate a secure random password during installation.
# For Proxmox LXC: Pass via environment variable:
#   SH3D_AUTH_USERNAME=myuser SH3D_AUTH_PASSWORD='MyStr0ng!Pass' bash -c "$(wget...)"
AUTH_PASSWORD=

# ============================================
# Advanced Configuration
# ============================================
# Time zone (optional)
# TZ=Europe/Rome

# ============================================
# NPMplus / Reverse Proxy Configuration (for reference)
# ============================================
# These values are not used by the container itself, but are provided
# as a reference for configuring your reverse proxy (NPMplus, Traefik, etc.)
#
# Domain name (configure in your reverse proxy)
# DOMAIN=sweethome.yourdomain.com
#
# Upstream target for reverse proxy
# UPSTREAM=http://IP_OF_LXC_CONTAINER:8080
